# The submission worker, and only the worker.
#
# It needs a real browser, which must never go into the public dashboard image:
# that service is internet-facing and has no business carrying Chromium. This
# is a separate image for a separate Cloud Run job, and the only thing it runs
# is the queue worker.
#
# Noble, not jammy: the jammy image ships Python 3.10 and this package needs
# 3.12. Ubuntu 24.04 ships 3.12.
#
# The tag must track the playwright pin in pyproject.toml, and the pip install
# below pins the exact same version — the base image bundles browsers built for
# one client version, and a mismatch fails at run time, not at build time.
FROM mcr.microsoft.com/playwright/python:v1.64.0-noble

# The base image lags on security fixes: take Ubuntu's (openssl) and drop to a
# patched virtualenv, which the image ships and the worker never uses.
RUN apt-get update && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir --break-system-packages --upgrade "virtualenv>=21.7.13"

WORKDIR /app
# Dependencies come from uv.lock, as in the dashboard image.
COPY --from=ghcr.io/astral-sh/uv:0.13.4 /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock README.md ./
RUN uv export --frozen --no-dev --extra gcs --no-emit-project -o /tmp/requirements.txt \
    && pip install --no-cache-dir --break-system-packages -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt
# Separate install: the exported requirements carry hashes, and pip refuses an
# unhashed extra in the same run. Keep this pin equal to the base image tag.
RUN pip install --no-cache-dir --break-system-packages "playwright==1.61.0"
COPY src ./src
COPY docs/data ./docs/data
RUN pip install --no-cache-dir --break-system-packages --no-deps .

ENV PYTHONUNBUFFERED=1
# Rehearses unless ALEX311_ALLOW_LIVE_SUBMIT=1 is set on the job AND --live is
# passed. Both are deliberate acts.
ENTRYPOINT ["python", "-m", "alex311.submit_worker"]
